## Secret every vault's agent wallet is derived from (one per vault). Generate with `cast keccak "$(openssl rand -hex 32)"`.
## Agent wallets hold only HSK for gas and can only call executeSwap, but keep this secret: it controls all of them.
AGENT_MASTER_KEY=0x
## Hopscotch Labs gateway key (ub_live_...). Needed for chat only.
HOPSCOTCH_API_KEY=xxxxxxx

## Optional
# HOPSCOTCH_MODEL=anthropic/claude-sonnet-5-5
# HOPSCOTCH_BASE_URL=https://api.hopscotchlabs.ai/v1
# RPC_URL=https://mainnet.hsk.xyz
# PORT=8787
# HOST=127.0.0.1   set 0.0.0.0 when hosting the API for other users
# FRONTEND_ORIGIN=http://localhost:3000   the dashboard's URL; sign-in messages must name this site
# SIMULATE_ONLY=1   decide and simulate, never send transactions
# AGENT=off         serve the API without running the trading loop
# KEDIA_NETWORK=fork   read ABI/addresses.fork.json and its RPC instead of mainnet (pnpm backend:fork sets it)
