# Operator key: a fresh wallet holding only ~2 HSK for gas. It can only call executeSwap.
OPERATOR_PRIVATE_KEY=0x
# Needed for chat only. Or run `ant auth login` instead.
ANTHROPIC_API_KEY=
# Optional
# CLAUDE_MODEL=claude-sonnet-5-5
# RPC_URL=https://mainnet.hsk.xyz
# PORT=8787
# FRONTEND_ORIGIN=http://localhost:3000
# SIMULATE_ONLY=1   decide and simulate, never send transactions
# AGENT=off         serve the API without running the trading loop
